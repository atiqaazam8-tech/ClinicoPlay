/*
  Cross-Origin-Embedder-Policy: unsafe-none
  Cross-Origin-Opener-Policy: unsafe-none

# Unity WebGL with "Decompression Fallback" enabled outputs .unityweb files.
# These files contain Brotli-compressed data handled by Unity's own JS loader.
# Setting "no-transform" prevents Cloudflare from re-compressing them,
# which would cause "EncodingError: Decoding failed".
/Build/*.unityweb
  Content-Type: application/octet-stream
  Cache-Control: no-transform, public, max-age=2592000

# The WebAssembly file needs the correct MIME type or some browsers refuse to load it
/Build/*.wasm
  Content-Type: application/wasm
  Cache-Control: no-transform, public, max-age=2592000

# Raw Brotli builds (if Decompression Fallback is OFF)
/Build/*.data.br
  Content-Encoding: br
  Content-Type: application/octet-stream
  Cache-Control: no-transform, public, max-age=2592000

/Build/*.wasm.br
  Content-Encoding: br
  Content-Type: application/wasm
  Cache-Control: no-transform, public, max-age=2592000

/Build/*.framework.js.br
  Content-Encoding: br
  Content-Type: application/javascript
  Cache-Control: no-transform, public, max-age=2592000

# Gzip variants
/Build/*.data.gz
  Content-Encoding: gzip
  Content-Type: application/octet-stream
  Cache-Control: no-transform, public, max-age=2592000

/Build/*.wasm.gz
  Content-Encoding: gzip
  Content-Type: application/wasm
  Cache-Control: no-transform, public, max-age=2592000

/Build/*.framework.js.gz
  Content-Encoding: gzip
  Content-Type: application/javascript
  Cache-Control: no-transform, public, max-age=2592000
